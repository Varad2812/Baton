# Postgres connection string (Render wires this automatically from the Blueprint)
DATABASE_URL="postgresql://user:password@localhost:5432/baton"

# Gemini. Without a key the app serves cached pipeline results.
GEMINI_API_KEY=""
# Set to 1 to force offline mode: cached answers and deterministic fallbacks only, no Gemini calls.
LLM_DISABLED=""
GEMINI_MODEL="gemini-3.5-flash"
# Fallback LLM when Gemini is out of quota (optional)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Protects admin-only routes (reset, seed:pipeline triggers)
ADMIN_TOKEN=""

# Optional: raises GitHub API limits for live repo import
GITHUB_TOKEN=""

# Public URL of the deployed app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encrypts stored OAuth tokens (AES-256-GCM) and signs visitor cookies. Optional: falls back to a key
# derived from ADMIN_TOKEN. Changing it signs every visitor out of their demo copy.
ENCRYPTION_KEY=""

# Optional: GitHub webhook (POST /api/webhooks/github) signature secret
GITHUB_WEBHOOK_SECRET=""

# Slack (docs/SLACK.md). Without these, the Slack buttons explain it and offer the export ZIP upload.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
# Pre-connected demo workspace (server-only; never sent to the browser)
SLACK_BOT_TOKEN=""
