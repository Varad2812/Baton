  {
    "number": 66,
    "html_url": "https://github.com/festflow-club/festflow/pull/66",
    "title": "feat(api): HMAC-signed ticket QR payload",
    "user": {
      "login": "meera-k",
      "id": 81234011,
      "type": "User",
      "html_url": "https://github.com/meera-k"
    },
    "state": "closed",
    "draft": false,
    "merged": true,
    "merged_at": "2026-03-05T13:20:00Z",
    "closed_at": "2026-03-05T13:20:00Z",
    "created_at": "2026-03-04T15:30:00Z",
    "base": {
      "ref": "main"
    },
    "head": {
      "ref": "signed-qr"
    },
    "labels": [
      {
        "name": "api"
      },
      {
        "name": "scanner"
      },
      {
        "name": "security"
      }
    ],
    "body": "QR codes now encode `ticketId.signature` where signature = HMAC-SHA256(ticketId, TICKET_SIGNING_SECRET). The scanner can verify tickets without network.\n\nOld test tickets will not scan after this.",
    "review_comments": [
      {
        "id": 1640006600,
        "user": {
          "login": "kabirshah",
          "id": 77320914,
          "type": "User",
          "html_url": "https://github.com/kabirshah"
        },
        "created_at": "2026-03-05T06:00:00Z",
        "body": "The scanner will need TICKET_SIGNING_SECRET in its bundle to verify offline."
      },
      {
        "id": 1640006601,
        "user": {
          "login": "meera-k",
          "id": 81234011,
          "type": "User",
          "html_url": "https://github.com/meera-k"
        },
        "created_at": "2026-03-05T06:32:00Z",
        "body": "Yes, that's the known trade-off. We accept it for 2026 and move to asymmetric signatures next year."
      }
    ]
  },
